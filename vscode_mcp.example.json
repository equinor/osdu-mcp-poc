{
  "servers": {
    "osdu-discovery": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/uv",
      "args": [
        "run",
        "--project",
        "/path/to/osdu-mcp-poc",
        "osdu-mcp",
        "--db",
        "/path/to/osdu-mcp-poc/chroma_db",
        "--specs",
        "/path/to/osdu-mcp-poc/specs",
        "--schemas",
        "/path/to/osdu-mcp-poc/schemas",
        "--model",
        "/path/to/osdu-mcp-poc/model/osdu_latest.yaml"
      ]
    }
  }
}
