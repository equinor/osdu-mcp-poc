{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "osdu-discovery": {
      "type": "local",
      "command": "/opt/homebrew/bin/uv",
      "args": [
        "run",
        "--project",
        "/path/to/osdu-mcp-poc",
        "osdu-mcp",
        "--db",
        "/path/to/osdu-mcp-poc/chroma_db",
        "--schemas",
        "/path/to/osdu-mcp-poc/schemas"
      ],
      "enabled": true
    }
  }
}
